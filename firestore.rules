rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    // Note: This reads the user document, so make sure users collection allows reads
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      // Allow users to read their own data
      // Allow authenticated users to read other users (needed for admin check and order display)
      allow read: if isAuthenticated();
      
      // Allow users to create/update their own data
      // Allow admins to update any user
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Orders collection
    match /orders/{orderId} {
      // Allow authenticated users to read all orders (needed for admin dashboard)
      allow read: if isAuthenticated();
      
      // Allow authenticated users to create orders
      allow create: if isAuthenticated();
      
      // Allow order owner or admin to update/delete
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
    
    // Admin Sessions collection
    match /adminSessions/{sessionId} {
      // Allow authenticated users to read/write their own sessions
      // This is more permissive but necessary for session management
      allow read, write: if isAuthenticated();
    }
    
    // Menu/Products collection
    match /menu/{menuId} {
      allow read: if true;
      allow write: if isAuthenticated() && isAdmin();
    }
    
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated() && isAdmin();
    }
    
    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated() && isAdmin();
    }
    
    // Food items collection (if exists)
    match /foodItems/{itemId} {
      allow read: if true;
      allow write: if isAuthenticated() && isAdmin();
    }
    
    // Cart collection (if exists)
    match /cart/{cartId} {
      allow read, write: if isAuthenticated() && isOwner(cartId);
    }
  }
}
